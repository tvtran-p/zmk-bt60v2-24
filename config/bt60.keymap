#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

// ---------------------------------------------------------------------------
// Pick ONE layout by uncommenting it. ANSI is the default.
// ---------------------------------------------------------------------------
#define ANSI
//#define ISO
//#define ALL_1U
//#define HHKB

// ---------------------------------------------------------------------------
// DEBOUNCE lives here (it's a devicetree setting, not a .conf option).
// Default is 5ms press / 5ms release. Uncomment and tune to taste.
// Lower = snappier, but too low can cause double-presses ("chatter").
// ---------------------------------------------------------------------------
//&kscan0 {
//    debounce-press-ms = <3>;
//    debounce-release-ms = <3>;
//};

/ {
  chosen {
  #ifdef ANSI
    zmk,physical-layout = &layout_60_ansi;
  #elif defined(ISO)
    zmk,physical-layout = &layout_60_iso;
  #elif defined(ALL_1U)
    zmk,physical-layout = &layout_60_all1u;
  #elif defined(HHKB)
    zmk,physical-layout = &layout_60_hhkb;
  #else
  #error "Layout not defined, please define a layout by uncommenting the appropriate line in bt60.keymap"
  #endif
  };
default_layer {
    // ------------------------------------------------------------------------------------------
    // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BSPC   |
    // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   \     |
    // | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
    // |  SHIFT    |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  | /   |      SHIFT     |
    // |  CTL  |  WIN  |  ALT  |            SPACE               | ALT |   FN  |  F13  |  CTRL  |
    // ------------------------------------------------------------------------------------------
  bindings = 
    &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp  N8   &kp  N9 &kp  N0  &kp MINUS &kp EQUAL &kp BSPC
    &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp  I    &kp  O  &kp  P   &kp LBKT &kp RBKT   &kp BSLH
    &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp  K    &kp  L  &kp SEMI &kp SQT            &kp RET
    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH                &kp RSHFT
    &kp LCTRL &kp LGUI &kp LALT            &kp SPACE                          &kp RALT  &mo 1 &kp F13    &kp RCTRL
  >;
  sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
};
